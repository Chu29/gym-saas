generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String       @unique
  status    TenantStatus @default(TRIAL)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  users       User[]
  members     MemberProfile[]
  plans       SubscriptionPlan[]
  services    Service[]
  rooms       RoomStation[]
  wallets     MemberWallet[]
  ledgerEntries TokenLedger[]
  redemptions ServiceRedemption[]

  @@map("tenants")
}

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  CANCELLED
}

model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String   @db.ObjectId
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String
  passwordHash String
  role         UserRole
  firstName    String
  lastName     String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberProfile      MemberProfile?
  handledRedemptions ServiceRedemption[] @relation("StaffHandledRedemptions")

  @@unique([tenantId, email])
  @@index([tenantId, role])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  GYM_ADMIN
  FRONT_DESK
  TRAINER
  MEMBER
}

model SubscriptionPlan {
  id                    String       @id @default(auto()) @map("_id") @db.ObjectId
  tenantId              String       @db.ObjectId
  tenant                Tenant       @relation(fields: [tenantId], references: [id])
  name                  String
  monthlyTokenAllowance Int
  priceCents            Int
  currency              String       @default("USD")
  billingCycle          BillingCycle @default(MONTHLY)
  tokenExpiryDays       Int?
  isActive              Boolean      @default(true)
  createdAt             DateTime     @default(now())

  members MemberProfile[]

  @@index([tenantId, isActive])
  @@map("subscription_plans")
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model MemberProfile {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String       @db.ObjectId
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  userId       String       @unique @db.ObjectId
  user         User         @relation(fields: [userId], references: [id])
  membershipNo String
  planId       String?      @db.ObjectId
  plan         SubscriptionPlan? @relation(fields: [planId], references: [id])
  status       MemberStatus @default(ACTIVE)
  joinedAt     DateTime     @default(now())

  wallet      MemberWallet?
  redemptions ServiceRedemption[]

  @@unique([tenantId, membershipNo])
  @@index([tenantId, status])
  @@map("member_profiles")
}

enum MemberStatus {
  ACTIVE
  FROZEN
  CANCELLED
}

model MemberWallet {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  tenantId  String   @db.ObjectId
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  memberId  String   @unique @db.ObjectId
  member    MemberProfile @relation(fields: [memberId], references: [id])
  balance   Int      @default(0)
  version   Int      @default(0)
  lastTxnAt DateTime?
  updatedAt DateTime @updatedAt

  ledgerEntries TokenLedger[]

  @@index([tenantId])
  @@map("member_wallets")
}

model TokenLedger {
  id                String          @id @default(auto()) @map("_id") @db.ObjectId
  tenantId          String          @db.ObjectId
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  walletId          String          @db.ObjectId
  wallet            MemberWallet    @relation(fields: [walletId], references: [id])
  memberId          String          @db.ObjectId
  type              TransactionType
  amount            Int
  balanceAfter      Int
  referenceId       String?
  performedByUserId String?         @db.ObjectId
  metadata          Json?
  createdAt         DateTime        @default(now())

  @@index([tenantId, memberId, createdAt])
  @@index([walletId])
  @@map("token_ledger")
}

enum TransactionType {
  SUBSCRIPTION_GRANT
  TOP_UP
  SERVICE_REDEMPTION
  EXPIRATION
  REFUND
  ADJUSTMENT
}

model Service {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  tenantId    String          @db.ObjectId
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  category    ServiceCategory
  tokenCost   Int
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())

  rooms       RoomStation[]
  redemptions ServiceRedemption[]

  @@unique([tenantId, name])
  @@index([tenantId, isActive])
  @@map("services")
}

enum ServiceCategory {
  SAUNA
  PERSONAL_TRAINING
  POOL
  GROUP_CLASS
  SPA
  OTHER
}

model RoomStation {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  tenantId     String       @db.ObjectId
  tenant       Tenant       @relation(fields: [tenantId], references: [id])
  name         String
  serviceId    String       @db.ObjectId
  service      Service      @relation(fields: [serviceId], references: [id])
  terminalType TerminalType
  qrCodeToken  String?      @unique
  deviceApiKey String?      @unique
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())

  redemptions  ServiceRedemption[]

  @@index([tenantId])
  @@map("room_stations")
}

enum TerminalType {
  QR_STATIC
  NFC_KIOSK
  RFID_KIOSK
}

model ServiceRedemption {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  tenantId        String           @db.ObjectId
  tenant          Tenant           @relation(fields: [tenantId], references: [id])
  memberId        String           @db.ObjectId
  member          MemberProfile    @relation(fields: [memberId], references: [id])
  serviceId       String           @db.ObjectId
  service         Service          @relation(fields: [serviceId], references: [id])
  roomStationId   String?          @db.ObjectId
  roomStation     RoomStation?     @relation(fields: [roomStationId], references: [id])
  method          RedemptionMethod
  tokensCharged   Int
  status          RedemptionStatus
  handledByUserId String?          @db.ObjectId
  handledByUser   User?            @relation("StaffHandledRedemptions", fields: [handledByUserId], references: [id])
  ledgerEntryId   String?          @db.ObjectId
  createdAt       DateTime         @default(now())

  @@index([tenantId, memberId, createdAt])
  @@index([tenantId, serviceId])
  @@map("service_redemptions")
}

enum RedemptionMethod {
  MOBILE_QR_SCAN
  KIOSK_NFC
  KIOSK_RFID
  STAFF_ASSISTED
}

enum RedemptionStatus {
  SUCCESS
  FAILED_INSUFFICIENT_TOKENS
  REVERSED
}
